# RANE VISTA station configuration. Copy this file to ".env" in the same folder as RANE_VISTA.exe
# (or main.py when running from source) and fill in the values. Run "RANE_VISTA.exe --check" afterwards.
# The .env file contains a secret: restrict NTFS permissions to administrators + the station user.
# Never commit .env to Git.

# --- Database ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=PDI_Inspection
DB_SCHEMA=pdi_inspection
# First start / commissioning: the schema owner (e.g. postgres) so the app can create its tables.
# Production: switch to the least-privilege account created by sql/admin/least_privilege_role.sql (vista_app).
DB_USER=postgres
DB_PASSWORD=Jey@Mech123
# prefer | require | disable  (use require when the database is on another machine)
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# --- Station -------------------------------------------------------------------
# Unique per inspection module (letters, digits, - and _), e.g. PDI-CC21-LH-01
STATION_CODE=PDI-STATION-01
STATION_NAME=PDI inspection station 1

# --- Camera --------------------------------------------------------------------
# realsense (Intel RealSense D456 / D457) or sim (simulator for engineering and training)
CAMERA_BACKEND=realsense
# Leave empty to use the first camera found
REALSENSE_SERIAL=
# 848x480 is the optimal depth resolution for D45x cameras
DEPTH_WIDTH=848
DEPTH_HEIGHT=480
CAMERA_FPS=30
# Optional dedicated 2D vision camera (UVC / DirectShow index) for fine quality checks, -1 = none
VISION_CAMERA_INDEX=-1

# --- Projector -----------------------------------------------------------------
# Only needed if a PJLink password is set in the projector's network menu
PROJECTOR_PJLINK_PASSWORD=

# --- Storage / logging ---------------------------------------------------------
# Evidence images, logs, spool and exports. Must be writable by the station user.
DATA_DIR=C:\ProgramData\RANE_VISTA
LOG_LEVEL=INFO
